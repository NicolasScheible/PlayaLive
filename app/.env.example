# Vorlage für lokale Umgebungsvariablen. Kopieren nach .env.local (nicht versioniert, siehe
# .gitignore) und mit echten Werten der jeweiligen Umgebung befüllen — siehe
# docs/ADR/008-Security.md und docs/Architecture.md Kapitel 17 „Sicherheit" für die
# Secrets-/Umgebungsstrategie (Development/Staging/Production, je eigenes Supabase-Projekt).
#
# EXPO_PUBLIC_-Variablen werden clientseitig in den JS-Bundle eingebettet und dürfen daher nur
# öffentliche/anonyme Schlüssel enthalten (z. B. Supabase anon key, Mapbox public access token) —
# niemals Service-Role-Keys oder andere geheime Zugangsdaten.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
